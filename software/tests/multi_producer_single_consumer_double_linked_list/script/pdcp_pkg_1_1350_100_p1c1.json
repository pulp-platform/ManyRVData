// Author: Zexin Fu <zexifu@iis.ee.ethz.ch>

// TC1 with a single producer and a single consumer.
//
// Dispatch follows these lists, not the PRODUCER_CORE_NUM/CONSUMER_CORE_NUM
// build defines, so a genuine one-consumer run needs its own header rather
// than an override. Its purpose is to be the C=1 control: anything that
// reproduces here is not a concurrency bug.
{
  "active_user_number": 1,
  "pkg_length": 1350,
  "pdcp_header_length": 10,
  "src_addr": "0xA0000000",
  "src_length": 16777216,
  "tgt_addr": "0xB0000000",
  "tgt_length": 16777216,
  "total_pkg_number": 100,
  "producer_cores": [0],
  "consumer_cores": [1]
}
